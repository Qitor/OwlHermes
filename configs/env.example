# Backend
DATABASE_URL=postgresql://risk:risk@localhost:5432/risk_signal
RISK_SIGNAL_API_BASE=http://127.0.0.1:8787
RISK_SIGNAL_API_TOKEN=change-me
APP_TIMEZONE=Asia/Shanghai

# Hermes / model
HERMES_CONFIG_PATH=~/.hermes/config.yaml

# Model tiering (optional — disabled by default)
AIRO_ENABLE_SMALL_MODEL=false
AIRO_SMALL_MODEL_PROVIDER=openai
AIRO_SMALL_MODEL_NAME=gpt-4o-mini
AIRO_SMALL_MODEL_BASE_URL=
AIRO_SMALL_MODEL_API_KEY_ENV=OPENAI_API_KEY
AIRO_STRONG_MODEL_NAME=
AIRO_SMALL_MODEL_TIMEOUT_SECONDS=60
AIRO_SMALL_MODEL_MAX_CONCURRENCY=2
AIRO_SMALL_MODEL_DRY_RUN=true

# Delivery
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
WECHAT_WEBHOOK_URL=

# Optional collectors
YOUTUBE_API_KEY=
ENABLE_AUDIO_TRANSCRIPTION=false
WHISPER_MODEL=small

# Crawler limits
FETCH_TIMEOUT_SECONDS=60
MAX_CONTENT_BYTES=5000000
MAX_TRANSCRIPT_CHARS=200000
USER_AGENT=HermesAIRiskSignalObserver/0.2
